@model SecurityServiceBackend.ViewModel.RegistroViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registrar usuario</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body>

    <div class="main-container">

        <div class="right-background">
            <img src="~/images/lines.png" class="line-image line-1" />
            <img src="~/images/lines.png" class="line-image line-2" />
        </div>

        <div class="login-container">

            <div class="login-content">

                <h1>Registrar usuario</h1>

                <form asp-controller="Registro"
                      asp-action="Registro"
                      method="post">

                    <label>Usuario</label>
                    <input asp-for="Usuario" placeholder="Usuario o correo" />
                    <span asp-validation-for="Usuario"></span>

                    <label>Nombre</label>
                    <input asp-for="Nombre" placeholder="Nombre completo" />
                    <span asp-validation-for="Nombre"></span>

                    <button type="submit">
                        Registrar
                    </button>

                    <button type="button"
                            class="btn-login"
                            onclick="location.href='/'">
                        Volver al login
                    </button>

                    @if (ViewBag.Error != null)
                    {
                        <p class="error">@ViewBag.Error</p>
                    }

                    @if (ViewBag.Mensaje != null)
                    {
                        <p class="success">@ViewBag.Mensaje</p>
                    }

                </form>

            </div>

        </div>

    </div>

</body>
</html>
