@model SecurityServiceBackend.ViewModel.CambiarPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Cambiar contraseña</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body>

    <div class="main-container">

        <div class="right-background">
            <img src="~/images/lines.png" class="line-image line-1" />
            <img src="~/images/lines.png" class="line-image line-2" />
        </div>

        <div class="login-container">

            <div class="login-content">

                <h1>Cambiar contraseña</h1>
                <p>Por seguridad debes establecer una nueva contraseña antes de continuar.</p>

                <form asp-controller="CambiarPassword"
                      asp-action="CambiarPassword"
                      method="post">

                    <label>Contraseña actual</label>
                    <input asp-for="PasswordActual" type="password" />
                    <span asp-validation-for="PasswordActual"></span>

                    <label>Nueva contraseña</label>
                    <input asp-for="PasswordNueva" type="password" />
                    <span asp-validation-for="PasswordNueva"></span>

                    <label>Confirmar nueva contraseña</label>
                    <input asp-for="ConfirmarPassword" type="password" />
                    <span asp-validation-for="ConfirmarPassword"></span>

                    <button type="submit">
                        Cambiar contraseña
                    </button>

                    @if (ViewBag.Error != null)
                    {
                        <p class="error">@ViewBag.Error</p>
                    }

                </form>

            </div>

        </div>

    </div>

</body>
</html>
