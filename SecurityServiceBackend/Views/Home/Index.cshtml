@model List<SecurityServiceBackend.Models.IngresoModel>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Gestión de Ingresos</title>
    <link rel="stylesheet" href="~/css/ingresos.css" />
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
</head>
<body>
    <!-- Cabecera -->
    <header class="header">
        <h1>NOMBRE EMPRESA</h1>
        <nav>
            <ul>
                <li>
                    <a asp-controller="Home"
                       asp-action="Index">
                        Ingresos
                    </a>
                </li>
                <li>
                    <a asp-controller="Usuarios"
                       asp-action="Index">
                        Usuarios
                    </a>
                </li>
                <li>
                    <a asp-controller="Login"
                       asp-action="Login">
                        Salir
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <!-- Filtros -->
    <section class="filters">

        <h2>Ingresos de vehículos</h2>

        <!-- IZQUIERDA -->
        <div class="search-group">

            <input id="buscarIngreso"
                   type="text"
                   placeholder="Buscar..." />

            <button id="btnBuscar"
                    class="btn-buscar">
                Buscar
            </button>

        </div>

        <!-- DERECHA -->
        @* <div class="filters-right">
            <input type="text"
                   placeholder="Seleccionar fecha de ingreso" />

            <input type="date" />
        </div> *@

    </section>

    <!-- Tabla -->
    <section class="table-section">
        <h2>Lista de ingresos</h2>
        <table id="tablaIngresos">
            <thead>
                <tr>
                    <th>Matrícula</th>
                    <th>Propietario Oficial</th>
                    <th>DNI</th>
                    <th>Hora ingreso</th>
                    <th>Hora salida</th>
                    <th>Usuario manejando</th>
                    <th>Área destino</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var ingreso in Model)
                {
                    <tr>

                        <td>@ingreso.Matricula</td>
                        <td>@ingreso.PropietarioOficial</td>
                        <td>@ingreso.DNI</td>
                        <td>@ingreso.HoraIngreso</td>
                        <td>@ingreso.HoraSalida</td>
                        <td>@ingreso.UsuarioManejando</td>
                        <td>@ingreso.AreaDestino</td>
                        <td>
                            <button class="btn-ver"
                                    onclick="abrirModal(
                                '@ingreso.Matricula',
                                '@ingreso.PropietarioOficial',
                                '@ingreso.DNI',
                                '@ingreso.HoraIngreso',
                                '@ingreso.HoraSalida',
                                '@ingreso.UsuarioManejando',
                                '@ingreso.AreaDestino'
                                )">
                                Ver
                            </button>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </section>
    <div id="modalIngreso" class="modal">
        <div class="modal-content">

            <span class="close"
                  onclick="cerrarModal()">
                &times;
            </span>
            <h2>Detalle Ingreso</h2>
            <p>
                <strong>Matrícula:</strong>
                <span id="mMatricula"></span>
            </p>
            <p>
                <strong>Propietario:</strong>
                <span id="mPropietario"></span>
            </p>
            <p>
                <strong>DNI:</strong>
                <span id="mDni"></span>
            </p>
            <p>
                <strong>Hora ingreso:</strong>
                <span id="mHoraIngreso"></span>
            </p>
            <p>
                <strong>Hora salida:</strong>
                <span id="mHoraSalida"></span>
            </p>
            <p>
                <strong>Usuario manejando:</strong>
                <span id="mUsuario"></span>
            </p>
            <p>
                <strong>Área destino:</strong>
                <span id="mArea"></span>
            </p>
        </div>

    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="~/js/ingresos.js"></script>
</body>
</html>

