@model List<SecurityServiceBackend.Models.Example>

@{

}

<div>Este es un formulacio para registrar al usuario</div>
<h2>Lista de Ejemplos</h2>

<table>
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
            </tr>
        }
    </tbody>
    <p>@ViewBag.Title</p>
    <button class="btn btn-primary">Ingresar</button>
</table>
