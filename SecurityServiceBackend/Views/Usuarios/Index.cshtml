@model SecurityServiceBackend.Models.UsuarioPaginadoModel

@{
    Layout = null;
    var busquedaActual = Context.Request.Query["buscar"].ToString();
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Gestión de Usuarios</title>
    <link rel="stylesheet" href="~/css/usuarios.css" />
    
</head>
<body>
    <!-- Cabecera -->
    <header class="header">
        <h1>NOMBRE EMPRESA</h1>
        <nav>
            <ul>
                <li>
                    <a asp-controller="Home"
                       asp-action="Index">
                        Ingresos
                    </a>
                </li>
                <li>
                    <a asp-controller="Usuarios"
                       asp-action="Index">
                        Usuarios
                    </a>
                </li>
                <li>

                    <form asp-controller="Login"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">


                        <button type="submit"
                                class="logout-link">

                            Salir

                        </button>


                    </form>

                </li>
                <li>

                    <a asp-controller="Acceso"
                       asp-action="Index">
                        Acceso
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <!-- Sección Usuarios -->
    <section class="usuarios-section">

        <h2>Usuarios</h2>

        <div class="filters">

            <!-- IZQUIERDA -->
            <div class="search-group">

                <input id="buscarUsuario"
                       name="buscar"
                       type="text"
                       placeholder="Buscar..." />

                <button type="button"
                        id="btnBuscar"
                        class="btn-buscar">
                    Buscar
                </button>

            </div>

            <!-- DERECHA -->
            <div class="filters-right">

                <button class="btn-reactivar">
                    Reactivar
                </button>

                <button class="btn-baja">
                    Dar de baja
                </button>

            </div>

        </div>

    </section>

    <!-- Tabla -->
    <section class="table-section">
        <h2>Lista de usuarios</h2>
        <table id="tablaUsuarios">
            <thead>
                <tr>

                    <th class="checkbox-col">
                        <input type="checkbox" />
                    </th>

                    <th>Nombre completo</th>
                    <th>DNI / Documento</th>
                    <th>N° Teléfono</th>
                    <th>Cargo</th>
                    <th>Departamento</th>
                    <th>Estado</th>
                    <th>Detalle</th>

                </tr>
            </thead>

            <tbody id="tablaDatos">

                @Html.Partial("_TablaUsuarios", Model.Usuarios)

            </tbody>
        </table>
        <div id="paginacion" class="paginacion">

            @Html.Partial("_PaginacionUsuarios", Model)

        </div>
        <div id="modalUsuario" class="modal">
            <div class="modal-content">
                <span class="close" onclick="cerrarModal()">
                    &times;
                </span>
                <h2>Detalle Usuario</h2>
                <p><strong>Nombre:</strong> <span id="mNombre"></span></p>
                <p><strong>DNI:</strong> <span id="mDni"></span></p>
                <p><strong>Teléfono:</strong> <span id="mTelefono"></span></p>
                <p><strong>Cargo:</strong> <span id="mCargo"></span></p>
                <p><strong>Departamento:</strong> <span id="mDepartamento"></span></p>
                <p><strong>Estado:</strong> <span id="mEstado"></span></p>
            </div>
        </div>
    </section>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    
    <script src="~/js/usuarios.js"></script>
</body>
</html>
